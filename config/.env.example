# ════════════════════════════════════════════════════════════════
#  livekit-homelab 배포 변수
#  사용:  cp config/.env.example config/.env  &&  $EDITOR config/.env
#  이 값들로 k8s/**/*.yaml.tpl 이 렌더링됩니다 (scripts/render.sh).
#  ※ render.sh 가 이 파일을 `source` 하므로 ${VAR} 중첩 참조가 동작합니다.
# ════════════════════════════════════════════════════════════════

# ── 도메인 / 호스트 ──────────────────────────────────────────────
DOMAIN=basphere.dev
LIVEKIT_HOST=livekit.${DOMAIN}        # 시그널링 WSS (443)
APP_HOST=app.${DOMAIN}                # 웹앱 HTTPS (443)

# ── 네트워크 (미디어 TCP) ────────────────────────────────────────
# 시나리오: 송출자(핸드폰)·시청자(PC) 모두 외부(인터넷). → node_ip=공인IP 단일값.
# OPNsense WAN 공인 IP — LiveKit ICE 후보(미디어 TCP)로 광고할 주소.
# 모든 클라이언트가 이 주소:${MEDIA_TCP_PORT} 로 직접 TCP 연결한다.
PUBLIC_IP=203.0.113.10
MEDIA_TCP_PORT=7881
# Cilium lb-pool(172.16.200.0/24)에서 미디어 LB 서비스에 고정할 IP (선택, 비우면 자동할당)
MEDIA_LB_IP=

# ── Kubernetes ──────────────────────────────────────────────────
K8S_NAMESPACE=livekit

# 기존 클러스터의 Gateway (HTTPRoute parentRef 용) — 실제 클러스터 값
GATEWAY_NAME=shared-gateway
GATEWAY_NAMESPACE=gateway-system
# Gateway 의 HTTP listener 이름 (sectionName)
GATEWAY_SECTION=http

# ── LiveKit 인증 (임의 생성: openssl rand -hex 16) ───────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret

# ── 웹앱 접근 비밀번호 ───────────────────────────────────────────
# 토큰 발급/녹화 API 호출 시 요구되는 공유 비밀번호 (데모용 간단 보호).
# 비워두면 보호가 비활성화된다. 운영시 반드시 설정할 것.
APP_PASSWORD=change-me-demo-password

# ── 클러스터 내부 주소 (자동 구성, 보통 수정 불필요) ─────────────
LIVEKIT_WS_URL_INTERNAL=ws://livekit.${K8S_NAMESPACE}.svc.cluster.local:7880
REDIS_ADDRESS=redis.${K8S_NAMESPACE}.svc.cluster.local:6379

# ── 이미지 / 버전 (2026-05 최신 안정) ────────────────────────────
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.12.0
EGRESS_IMAGE=livekit/egress:v1.13.0
REDIS_IMAGE=redis:7-alpine
# 웹앱 이미지 (scripts 로 빌드/푸시할 레지스트리 경로)
APP_IMAGE=ghcr.io/garlickim21/livekit-homelab-web:latest
# 브라우저(프론트엔드)가 CDN 에서 불러올 클라이언트 SDK 버전
LIVEKIT_CLIENT_VERSION=2.19.1
# 토큰 서버(server.js)가 쓰는 server SDK 버전 (package.json 과 일치)
SERVER_SDK_VERSION=2.15.4

# ── 녹화 (Egress) ───────────────────────────────────────────────
# 녹화 활성화 여부. true 면 Redis + Egress 가 함께 배포된다.
ENABLE_RECORDING=true
# 저장 방식: 로컬 PVC (S3 불필요). 파일은 egress 파드의 PVC 에 저장된다.
RECORDING_PATH=/out
RECORDING_PVC_SIZE=20Gi
# RWX(NFS/Longhorn 등)면 여러 파드/외부 접근에 유리. 단일 인스턴스는 RWO 로 충분.
RECORDING_PVC_ACCESS_MODE=ReadWriteOnce
# 비우면 클러스터 기본 StorageClass 사용 (이 클러스터 기본 = vsphere-csi, RWO).
RECORDING_STORAGE_CLASS=
# Egress 파드 리소스 (단일 영상+오디오=Participant Egress 기준 ~4CPU/4GB.
# Room Composite(헤드리스 Chrome) 사용 시 6 이상 권장)
EGRESS_CPU=4
EGRESS_MEMORY=4Gi
EGRESS_SHM_SIZE=1Gi          # Chrome(/dev/shm)용. Participant/Track 전용이면 불필요하나 무해.

# ── 데모 기본값 ─────────────────────────────────────────────────
DEFAULT_ROOM=demo-room
